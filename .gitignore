# ==========================================
# Local Environment Variables
# ==========================================
# Do NOT commit sensitive API keys or secrets
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# Allow committing environment templates/example files
!.env.example
!.env.sample

# ==========================================
# Vercel & Deployment Tooling
# ==========================================
.vercel

