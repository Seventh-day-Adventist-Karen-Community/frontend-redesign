# Address of the Django/Graphene backend. Any of these forms works:
#   https://admin.sdackc.org            ("/graphql" is added for you)
#   https://admin.sdackc.org/graphql    (used exactly as given)
#   https://admin.sdackc.org/graphql/   (used exactly as given - keep the slash if your backend needs it)
# Leave unset to run /giving on built-in sample data (no payment is made).
NEXT_PUBLIC_GRAPHQL_URL=http://127.0.0.1:8000

# Optional: how long /giving waits for the giver's M-Pesa PIN response.
# Defaults: ask every 3000 ms, up to 40 times (about 2 minutes).
# NEXT_PUBLIC_GIVING_POLL_MS=3000
# NEXT_PUBLIC_GIVING_MAX_POLLS=40
